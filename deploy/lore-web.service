[Unit]
Description=Lore web server
Wants=network-online.target lore-api.service
After=network-online.target lore-api.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/lore-native/current/web
Environment=NODE_ENV=production HOSTNAME=127.0.0.1 PORT=3200 API_INTERNAL_URL=http://127.0.0.1:4200 APP_ORIGIN=https://lore.afolarin.cv NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=256
ExecStart=/usr/bin/node apps/web/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryMax=384M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
