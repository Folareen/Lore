# Local development only. These credentials are not suitable for deployment.
POSTGRES_USER=lore
POSTGRES_PASSWORD=lore_local
POSTGRES_DB=lore
POSTGRES_PORT=55432
REDIS_PORT=56379
DATABASE_URL=postgresql://lore:lore_local@127.0.0.1:55432/lore
REDIS_URL=redis://127.0.0.1:56379
API_PORT=4000
# Keep loopback for local processes; production containers set 0.0.0.0 internally.
API_HOST=127.0.0.1
API_INTERNAL_URL=http://127.0.0.1:4000
# Twitch-only login. Configure all three values together; blank values disable login locally.
# Register APP_ORIGIN/api/auth/twitch/callback in the Twitch developer console.
APP_ORIGIN=http://localhost:3000
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Generate once with: openssl rand -base64 32. Keep it stable to decrypt stored tokens.
AUTH_ENCRYPTION_KEY=
# Optional live ingestion: configure both after exposing Lore through public HTTPS.
# The callback path is fixed. Use a separate random secret; never reuse the auth key.
TWITCH_EVENTSUB_CALLBACK_URL=
# Generate with: openssl rand -hex 32
TWITCH_EVENTSUB_SECRET=
# Keep one stable prefix per application/database; tests use isolated prefixes.
QUEUE_PREFIX=lore
# Production requires NODE_ENV=production, an HTTPS APP_ORIGIN, and all auth credentials.
# Never use NEXT_PUBLIC_ for secrets.
# Integration tests create/drop isolated temporary databases; this user needs CREATEDB.
TEST_DATABASE_URL=postgresql://lore:lore_local@127.0.0.1:55432/lore
# Gemini powers extraction, precedent embeddings and case recommendations. Owners opt in per channel.
# Use a Free-tier AI Studio project; pricing/quota depends on the project, not this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Public community Q&A uses a separate lightweight model and budgets.
GEMINI_COMMUNITY_MODEL=gemini-3.5-flash-lite
COMMUNITY_AI_DAILY_LIMIT=100
COMMUNITY_AI_GLOBAL_DAILY_LIMIT=500
# Hard per-channel provider-attempt limit per UTC day (includes retries).
AI_DAILY_CALL_LIMIT=50
# Private Cloudflare R2 bucket. Create an Object Read & Write token scoped to this bucket.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
